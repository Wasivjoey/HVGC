# Copy to .env and adjust.

# Port the dashboard + API listen on
PORT=3000

# Password to log in to the dashboard (CHANGE THIS)
DASHBOARD_PASSWORD=change-me

# Secret used to sign session cookies (set to a long random string)
SESSION_SECRET=please-change-this-to-a-long-random-string

# How often the scheduler checks for due posts (milliseconds)
SCHEDULER_TICK_MS=15000

# When a single post targets multiple groups, wait a random delay between
# each group send to look human and reduce ban risk. Range in milliseconds.
SEND_JITTER_MIN_MS=4000
SEND_JITTER_MAX_MS=18000

# Max attempts before a post is marked failed
MAX_SEND_ATTEMPTS=3
